---
import {  Mail, Menu, X } from "@lucide/astro";
// import { SiTiktok } from "@icons-pack/react-simple-icons";
---

<div x-data="{ open: false }">
  <!-- Mobile -->
  <header class="lg:hidden fixed top-0 left-0 w-full z-50 border-b border-white/10 backdrop-blur-md bg-black/70">
    <div class="flex items-center justify-between px-6 py-4">
      <a href="/" class="text-xs tracking-[0.35em] uppercase">
        FramesBy<span class="bg-linear-to-r from-brand-primary via-brand-primary to-brand-accent bg-clip-text text-transparent">Alyssa</span>
      </a>
      <button
        @click="open = true"
        class="cursor-pointer text-off-white/70 hover:text-white transition"
        aria-label="Open Menu"
      >
        <Menu size={18} />
      </button>
    </div>
  </header>

  <!-- Mobile Overlay -->
  <div
    x-show="open"
    x-transition.opacity
    class="fixed inset-0 z-50 bg-bg flex flex-col justify-center items-center lg:hidden"
  >
    <button
      @click="open = false"
      class="cursor-pointer absolute top-6 right-6 text-off-white/70 hover:text-white"
      aria-label="Close Menu"
    >
      <X size={20} />
    </button>
    <nav class="flex flex-col items-center gap-8 text-sm uppercase tracking-[0.3em]">
      <a href="/" @click="open = false">Home</a>
      <a href="/concerts" @click="open = false">
        Concerts
      </a>
      <a class="line-through pointer-events-none" href="/travel" @click="open = false">
        Travel
      </a>
      <a class="line-through pointer-events-none" href="/moments" @click="open = false">
        Moments
      </a>
      <a class="line-through pointer-events-none" href="/video" @click="open = false">
        Video
      </a>
      <a href="/journal" @click="open = false">
        Journal
      </a>
      <a href="/about" @click="open = false">
        About
      </a>
    </nav>
    <div class="flex items-center gap-5 mt-16 text-off-white/50">
      <a href="https://instagram.com/framesbyalyssa" target="_blank">
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="currentColor" width="800px" height="800px" viewBox="0 0 32 32" id="Camada_1" version="1.1" xml:space="preserve">
