        class="inline-flex flex-col items-center font-heading font-extrabold text-xl tracking-[0.35em] uppercase leading-none mb-8"
      >
        <span>FramesBy</span>
        <span class="text-4xl bg-linear-to-r from-brand-primary via-brand-primary to-brand-accent bg-clip-text text-transparent">
          Alyssa
        </span>
      </a>
      <nav class="flex flex-col gap-5 text-xs tracking-[0.25em] uppercase font-semibold text-off-white/50">
        <a href="/" class="hover:text-white transition">Home</a>
        <a href="/concerts" class="hover:text-white transition">
